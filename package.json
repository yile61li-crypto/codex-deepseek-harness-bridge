{
  "name": "codex-deepseek-harness-bridge",
  "version": "0.5.1",
  "description": "A local-first MCP bridge that lets Codex operate visible DeepSeek Harness sessions.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "DeepSeek Harness Bridge contributors",
  "keywords": [
    "codex",
    "deepseek",
    "deepseek-harness",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent-orchestration",
    "local-first"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "packageManager": "npm@10.9.8",
  "bin": {
    "codex-deepseek-harness-bridge": "scripts/server.mjs"
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "skills",
    "scripts",
    "src",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check scripts/server.mjs && node --check scripts/live-probe.mjs && node --check scripts/mcp-live-probe.mjs && node --check src/dsh-client.mjs",
    "test": "node --test",
    "test:live": "node scripts/live-probe.mjs",
    "test:mcp-live": "node scripts/mcp-live-probe.mjs",
    "validate:plugin": "node .github/scripts/validate-plugin.mjs",
    "verify": "npm run check && npm test && npm run validate:plugin",
    "pack:dry-run": "npm pack --dry-run"
  }
}
