{
  "mcpServers": {
    "deepseek-harness": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "DSH_WEB_URL": "http://127.0.0.1:3080",
        "DSH_RUNTIME_COMMAND": "",
        "DSH_RUNTIME_ARGS_JSON": "",
        "DSH_RUNTIME_CWD": "",
        "DSH_RUNTIME_LOG_DIR": "",
        "DSH_RUNTIME_START_TIMEOUT_MS": "30000",
        "DSH_DEFAULT_PERMISSION": "read-only",
        "DSH_MAX_PERMISSION": "danger-full-access",
        "DSH_SETTINGS_FILE": "",
        "DSH_DEFAULT_CWD": "",
        "DSH_DEFAULT_WORKSPACE_ID": "",
        "DSH_ENABLE_APPROVAL_RESPONSES": "false",
        "DSH_ENABLE_QUESTION_RESPONSES": "false",
        "DSH_MAX_CONCURRENT_WAITS": "4",
        "DSH_MODEL_REQUESTS_PER_MINUTE": "12"
      }
    }
  }
}
